#!/usr/bin/env bash
# Génère un jeu de données aléatoire (cours, fichiers, créneaux) dans ~/.teacherflow/data.json,
# pour explorer l'interface sans tout créer à la main. Sauvegarde les données existantes en .bak.
# Usage : bin/donnees-test

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJET_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
cd "$PROJET_DIR" || exit 1

CLASSPATH_CACHE="target/lecture-classpath.txt"

if [ ! -d target/classes ]; then
    mvn -q compile || exit 1
fi

if [ ! -f "$CLASSPATH_CACHE" ] || [ pom.xml -nt "$CLASSPATH_CACHE" ]; then
    mvn -q dependency:build-classpath -Dmdep.outputFile="$CLASSPATH_CACHE" || exit 1
fi

exec java --module-path "target/classes:$(cat "$CLASSPATH_CACHE")" \
    --add-modules com.teacherflow.app \
    --module com.teacherflow.app/com.teacherflow.cli.GenererDonneesTest
