#!/usr/bin/env bash
# Construit un paquet natif installable de CourseFlow (jpackage), avec deux points d'entrée
# dans la même image : "courseflow" (interface graphique) et "lecture" (CLI, équivalent packagé
# de bin/lecture). Produit dans target/dist/ :
#   - un app-image portable (courseflow/), utilisable sans installation ;
#   - un paquet .deb installable via dpkg.
# Usage : bin/build-installer

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJET_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
cd "$PROJET_DIR" || exit 1

if ! command -v jpackage >/dev/null || ! command -v jlink >/dev/null; then
    echo "jpackage/jlink introuvables : un JDK complet (pas juste un JRE) est nécessaire." >&2
    exit 1
fi

JAVA_HOME="${JAVA_HOME:-$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")}"
if [ ! -d "$JAVA_HOME/jmods" ]; then
    echo "JAVA_HOME ($JAVA_HOME) ne contient pas de dossier jmods : un JDK complet est nécessaire." >&2
    exit 1
fi

echo "==> Compilation et tests"
# "install" (pas juste "test") : les étapes suivantes lancent des objectifs Maven isolés
# (dependency:copy-dependencies sur le module "app") qui doivent pouvoir résoudre
# courseflow-core depuis le dépôt local, pas seulement depuis le résultat du reactor en cours.
mvn -q clean install
mkdir -p target

echo "==> Copie des dépendances runtime (JavaFX, AtlantaFX, Jackson)"
rm -rf target/modules
mvn -q dependency:copy-dependencies -DoutputDirectory="$PROJET_DIR/target/modules" -DincludeScope=runtime

echo "==> Construction de l'image d'exécution (jlink)"
rm -rf target/runtime
jlink \
    --module-path "core/target/classes:app/target/classes:target/modules:$JAVA_HOME/jmods" \
    --add-modules com.courseflow.app \
    --output target/runtime \
    --strip-debug \
    --no-header-files \
    --no-man-pages \
    --compress zip-9

VERSION="1.0.0"
DESCRIPTION="Organise les fichiers de cours autour de l'emploi du temps"

echo "==> Construction de l'app-image (jpackage)"
rm -rf target/dist
jpackage \
    --type app-image \
    --runtime-image target/runtime \
    --name courseflow \
    --app-version "$VERSION" \
    --vendor CourseFlow \
    --description "$DESCRIPTION" \
    --icon packaging/icon/courseflow.png \
    --module com.courseflow.app/com.courseflow.app.App \
    --add-launcher lecture=packaging/lecture-launcher.properties \
    --dest target/dist

# Le lanceur natif jpackage interroge rpm/dpkg à chaque démarrage pour s'auto-identifier
# (~1-1,3 s perdues à chaque lancement, mesuré au strace) : inutile pour une commande CLI censée
# être instantanée. On le remplace par un script qui appelle directement le runtime packagé.
echo "==> Remplacement du lanceur lecture par un appel direct au runtime"
cat > target/dist/courseflow/bin/lecture << 'SCRIPT_LECTURE_FAST'
#!/bin/sh
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
exec "$SCRIPT_DIR/../lib/runtime/bin/java" \
    -Dcourseflow.bindir="$SCRIPT_DIR" \
    -m com.courseflow.core/com.courseflow.cli.Lecture "$@"
SCRIPT_LECTURE_FAST
chmod 755 target/dist/courseflow/bin/lecture

echo "==> Construction du paquet .deb (jpackage)"
jpackage \
    --type deb \
    --runtime-image target/runtime \
    --name courseflow \
    --app-version "$VERSION" \
    --vendor CourseFlow \
    --description "$DESCRIPTION" \
    --icon packaging/icon/courseflow.png \
    --module com.courseflow.app/com.courseflow.app.App \
    --add-launcher lecture=packaging/lecture-launcher.properties \
    --linux-shortcut \
    --linux-app-category Education \
    --resource-dir packaging/deb \
    --dest target/dist

echo "==> Terminé. Contenu de target/dist :"
ls target/dist
